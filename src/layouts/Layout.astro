---
interface Props {title:string;description:string;canonical:string;noindex?:boolean}
const {title,description,canonical,noindex=false}=Astro.props;
const schema={'@context':'https://schema.org','@type':'WebSite',name:'AICost Matrix',url:'https://aicost.apexcraftweb.com',description:'Source-linked text API fee estimates from a stored reference dataset.'};
---
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>{noindex&&<meta name="robots" content="noindex,follow"/>}<meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:type" content="website"/><meta name="twitter:card" content="summary"/><link rel="icon" href="/favicon.svg"/><script type="application/ld+json" set:html={JSON.stringify(schema)}/></head>
<body><a class="skip" href="#main">Skip to content</a><header><nav class="wrap"><a href="/" class="brand">⚡ AICost Matrix</a><div><a href="/#calculator">Budget</a><a href="/usage">Usage checker</a><a href="/methodology">Sources</a></div></nav></header><main id="main"><slot/></main><footer><div class="wrap"><p><strong>AICost Matrix</strong> · Free tools for explainable text API cost estimates.</p><p>Reference prices change. Verify your provider, model, mode and billing scope. No handbook is currently sold.</p><div class="actions"><a href="/methodology">Methodology</a><a href="/privacy">Privacy</a><a href="/terms">Terms</a><a href="/disclosure">Disclosure</a><a href="/handbook">Handbook status</a></div><p>© 2026 ApexCraft</p></div></footer></body></html>
<style is:global>
:root{font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:#182235;background:#f6f7fb;line-height:1.6;font-synthesis:none}*{box-sizing:border-box}body{margin:0}a{color:#6135c6;text-underline-offset:3px}a:hover{color:#351a80}h1,h2,h3,p{margin:0 0 1rem}h1{font-size:clamp(2.5rem,6vw,4rem);line-height:1.12;letter-spacing:-.04em}h2{font-size:clamp(1.5rem,3vw,2rem);line-height:1.25;letter-spacing:-.025em}h3{font-size:1.1rem;margin-top:1.4rem}.wrap{max-width:1100px;margin:auto;padding:0 24px}.flow>*{min-width:0}.flow{display:grid;gap:28px;padding-top:32px;padding-bottom:40px}header{background:white;border-bottom:1px solid #e0e3ee}nav{min-height:76px;display:flex;align-items:center;justify-content:space-between;gap:20px}nav div{display:flex;gap:24px;font-size:.9rem}.brand{text-decoration:none;font-weight:800;color:#242237}.hero{background:#161b30;color:white;padding:70px 0 60px}.hero .hint{color:#b7bed5}.intro{max-width:670px;font-size:1.15rem;color:#cbd0e5;margin:24px 0}.eyebrow{text-transform:uppercase;font-size:.76rem;font-weight:750;letter-spacing:.12em;color:#7350c7;margin-bottom:14px}.hero .eyebrow{color:#c4b5fd}.actions{display:flex;gap:16px;flex-wrap:wrap;align-items:center;margin:20px 0}.primary,.secondary{display:inline-block;border:1px solid #d6d4e4;border-radius:9px;padding:12px 18px;text-decoration:none;font:inherit;font-weight:650;cursor:pointer;background:white;color:#392c58}.primary{background:#6b3dd1;color:white;border-color:#6b3dd1}.primary:hover{background:#5328b1;color:white}.secondary:hover{background:#f1edfb}.panel{min-width:0;background:white;border:1px solid #e0e3ee;border-radius:16px;padding:32px;box-shadow:0 4px 18px #20204004}.section-heading{display:flex;justify-content:space-between;align-items:start;gap:16px}.pill{font-size:.75rem;background:#eeebfa;color:#5b34ad;border-radius:30px;padding:6px 10px;white-space:nowrap}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px 24px;margin:24px 0}label{display:block;font-size:.88rem;font-weight:650}input,select,textarea{font:inherit;display:block;margin-top:7px;border:1px solid #bec5d4;border-radius:8px;background:white;color:#172033;width:100%;padding:10px 12px}input:focus,select:focus,textarea:focus,button:focus-visible,a:focus-visible,summary:focus-visible{outline:3px solid #a795e7;outline-offset:3px}textarea{font-family:ui-monospace,monospace;min-height:240px;font-size:.85rem}.hint{font-size:.83rem;color:#606b80;margin:16px 0;overflow-wrap:anywhere}.error{background:#fff1f0;color:#a32124;border-left:3px solid #c62f35;padding:16px;margin-top:20px}.metrics{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:14px;margin:24px 0}.metrics>div{border:1px solid #e4e5ef;border-radius:10px;padding:16px;background:#f8f9fc}.metrics span{display:block;font-size:.75rem;color:#606b80}.metrics strong{display:block;font-size:1.5rem;overflow-wrap:anywhere}.metrics .accent{background:#f0eafd;border-color:#d5c7f1}.table-wrap{overflow-x:auto;margin:20px 0}table{width:100%;border-collapse:collapse;font-size:.85rem;text-align:left}th,td{padding:12px 10px;border-bottom:1px solid #e4e6ef;white-space:nowrap}th{background:#f5f5fa}caption{text-align:left;color:#606b80;font-size:.8rem;padding-bottom:12px}details{border-top:1px solid #e4e6ef;padding:18px 0}summary{font-weight:650;cursor:pointer}details p{margin-top:12px}footer{background:#eaeef5;padding:38px 0;color:#546078;font-size:.85rem;margin-top:40px}footer .actions{gap:22px}.skip{position:absolute;top:-100px}.skip:focus{top:5px;background:white;padding:12px;z-index:10}[hidden]{display:none!important}.check-label{display:flex;align-items:start;gap:10px;margin:16px 0}.check-label input{width:18px;margin-top:4px;flex-shrink:0}.status{background:#fff6da;padding:18px;border-radius:10px}.narrow{max-width:850px;padding-top:48px;padding-bottom:48px}code{background:#f0edf7;padding:2px 5px;border-radius:4px;overflow-wrap:anywhere}li{margin-bottom:10px}@media(max-width:640px){.wrap{padding-left:16px;padding-right:16px}nav{align-items:start;flex-direction:column;padding-top:14px!important;padding-bottom:14px!important;gap:10px}nav div{gap:18px}.panel{padding:22px 18px}.form-grid{grid-template-columns:1fr}.hero{padding:45px 0}.section-heading{flex-direction:column}.metrics{grid-template-columns:repeat(2,minmax(0,1fr))}.metrics strong{font-size:1.25rem}}
</style>
