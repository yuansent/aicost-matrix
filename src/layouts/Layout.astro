---
interface Props {
  title: string;
  description: string;
  canonical: string;
}
const { title, description, canonical } = Astro.props;

// Schema.org structured data
const schemaWebsite = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "AI API Cost Matrix",
  "url": "https://aicost.apexcraftweb.com",
  "description": "Real-time AI API pricing calculator and comparison tool for LLM models"
};
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="AI API Cost Matrix" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <!-- Schema.org -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaWebsite)} />

  <!-- Favicon placeholder -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class="bg-white text-slate-900 font-sans antialiased">

  <!-- Navigation -->
  <nav class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-slate-100 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2 font-bold text-slate-900 text-lg">
        <span class="text-purple-600">⚡</span> AICost Matrix
      </a>
      <div class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-600">
        <a href="/" class="hover:text-purple-600 transition-colors">Calculator</a>
        <a href="/handbook" class="hover:text-purple-600 transition-colors">Pro Handbook</a>
        <a href="https://stackcost.apexcraftweb.com" target="_blank" rel="noopener" class="hover:text-purple-600 transition-colors">Cloud Costs ↗</a>
        <a href="https://salary.apexcraftweb.com" target="_blank" rel="noopener" class="hover:text-purple-600 transition-colors">Dev Salaries ↗</a>
      </div>
      <a href="https://apexcraftweb.gumroad.com/l/aicost-handbook"
         target="_blank" rel="noopener sponsored"
         class="bg-purple-600 hover:bg-purple-700 text-white text-sm font-semibold px-4 py-2 rounded-lg transition-all">
        💎 Pro — $14.99
      </a>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <!-- Footer -->
  <footer class="bg-slate-900 text-slate-400 py-12 px-4 mt-16">
    <div class="max-w-5xl mx-auto">
      <div class="grid md:grid-cols-4 gap-8 mb-8">
        <div class="col-span-1">
          <div class="font-bold text-white text-lg mb-3">⚡ AICost Matrix</div>
          <p class="text-sm">Real-time AI API pricing calculator. Updated monthly. Free to use.</p>
        </div>
        <div>
          <div class="font-semibold text-white mb-3 text-sm">Models</div>
          <ul class="space-y-2 text-sm">
            <li><a href="/model/gpt-4o" class="hover:text-white transition-colors">GPT-4o Pricing</a></li>
            <li><a href="/model/claude-3-5-sonnet" class="hover:text-white transition-colors">Claude 3.5 Sonnet</a></li>
            <li><a href="/model/deepseek-v3" class="hover:text-white transition-colors">DeepSeek V3</a></li>
            <li><a href="/model/llama-3-3-70b-groq" class="hover:text-white transition-colors">Llama 3.3 (Groq)</a></li>
          </ul>
        </div>
        <div>
          <div class="font-semibold text-white mb-3 text-sm">Comparisons</div>
          <ul class="space-y-2 text-sm">
            <li><a href="/compare/gpt-4o-vs-claude-3-5-sonnet" class="hover:text-white transition-colors">GPT-4o vs Claude 3.5</a></li>
            <li><a href="/compare/gpt-4o-mini-vs-deepseek-v3" class="hover:text-white transition-colors">GPT-4o mini vs DeepSeek</a></li>
            <li><a href="/compare/llama-3-3-70b-groq-vs-gpt-4o" class="hover:text-white transition-colors">Groq vs GPT-4o</a></li>
            <li><a href="/compare/deepseek-v3-vs-claude-3-5-sonnet" class="hover:text-white transition-colors">DeepSeek vs Claude</a></li>
          </ul>
        </div>
        <div>
          <div class="font-semibold text-white mb-3 text-sm">More Tools</div>
          <ul class="space-y-2 text-sm">
            <li><a href="https://stackcost.apexcraftweb.com" target="_blank" rel="noopener" class="hover:text-white transition-colors">Cloud Stack Cost ↗</a></li>
            <li><a href="https://salary.apexcraftweb.com" target="_blank" rel="noopener" class="hover:text-white transition-colors">Remote Salaries ↗</a></li>
            <li><a href="https://nomad.apexcraftweb.com" target="_blank" rel="noopener" class="hover:text-white transition-colors">Nomad Visas ↗</a></li>
            <li><a href="/handbook" class="hover:text-white transition-colors">Pro Handbook</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-slate-800 pt-6 flex flex-col md:flex-row justify-between items-center gap-4 text-xs">
        <div>© 2026 ApexCraft. AI API prices sourced from official provider documentation.</div>
        <div class="flex gap-4">
          <a href="/privacy" class="hover:text-white transition-colors">Privacy</a>
          <a href="/terms" class="hover:text-white transition-colors">Terms</a>
          <a href="/disclosure" class="hover:text-white transition-colors">Affiliate Disclosure</a>
        </div>
      </div>
    </div>
  </footer>
</body>
</html>
