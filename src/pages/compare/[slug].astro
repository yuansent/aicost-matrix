---
import models from '../../data/models.json';
import legacy from '../../data/legacy-models.json';
import Layout from '../../layouts/Layout.astro';
export function getStaticPaths(){const paths=[];for(const [list,verified] of [[models,true],[legacy,false]]){for(let i=0;i<list.length;i++)for(let j=i+1;j<list.length;j++){paths.push({params:{slug:`${list[i].id}-vs-${list[j].id}`},props:{a:list[i],b:list[j],verified}});}}return paths;}
const {a,b,verified}=Astro.props;
---
<Layout title={`${a.name} vs ${b.name} — ${verified?'Reference Token Prices':'Comparison Not Verified'}`} description={verified?'Compare source-linked reference token prices. Same token counts do not guarantee the same task quality.':'This older comparison has not been verified. Its former price and performance recommendations are withdrawn.'} canonical={`https://aicost.apexcraftweb.com/compare/${a.id}-vs-${b.id}`} noindex={!verified}>
<div class="wrap narrow flow"><section><h1>{a.name}<br/>vs {b.name}</h1></section><section class="panel">{verified?<><h2>Reference prices · USD per million tokens</h2><p>Direct Claude API, global routing, standard mode, prompt ≤100,000 tokens. Checked 2026-11-14.</p><div class="table-wrap"><table><thead><tr><th>Bucket</th><th>{a.name}</th><th>{b.name}</th></tr></thead><tbody>{['input','output','cacheRead','cacheWrite5m','cacheWrite1h'].map(k=><tr><td>{k}</td><td>${a.rates[k]}</td><td>${b.rates[k]}</td></tr>)}</tbody></table></div><p><a href={a.sourceUrl}>Official pricing ↗</a> · <a href="/methodology">Methodology</a></p><p>Lower token fees do not establish equivalent quality, speed or cost per successful task. Measure each model on your own workload.</p></>:<><h2>Older comparison · not verified</h2><p class="status">The previous prices, speed estimates and recommendations on this page have not been verified for the current version and are no longer shown as current facts.</p><p>Check both providers’ official prices and model availability. This notice does not imply either model is retired.</p></>}<a class="primary" href="/#calculator">Build a source-linked budget →</a></section></div></Layout>
