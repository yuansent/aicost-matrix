---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="AI API Cost Optimization Handbook — Cut Your LLM Bill by 40-80%"
  description="40-page guide with proven architectures to reduce AI API costs: prompt caching, model routing, batching, and open-source swap playbooks. Instant PDF delivery."
  canonical="https://aicost.apexcraftweb.com/handbook"
>
  <div class="max-w-3xl mx-auto px-4 py-16">
    <div class="text-center mb-12">
      <div class="text-6xl mb-4">🚀</div>
      <h1 class="text-4xl font-bold text-slate-900 mb-4">AI API Cost Optimization Handbook</h1>
      <p class="text-xl text-slate-600 mb-2">Cut your LLM API bill by 40–80% with proven engineering patterns</p>
      <div class="text-3xl font-bold text-purple-700 mb-8">$14.99 · PDF + Live Vault Access</div>
      <a href="https://apexcraftweb.gumroad.com/l/aicost-handbook"
         target="_blank" rel="noopener sponsored"
         class="inline-flex items-center gap-2 bg-purple-600 hover:bg-purple-700 text-white font-bold py-5 px-10 rounded-2xl text-xl transition-all shadow-xl shadow-purple-200">
        Get Instant Access →
      </a>
      <p class="text-sm text-slate-400 mt-3">Instant PDF + 30-day money-back guarantee</p>
    </div>

    <div class="space-y-6">
      {[
        { icon: '💾', title: 'Prompt Caching Mastery', desc: 'Reduce input costs by 50–90% with OpenAI and Anthropic prompt caching. Exact implementation patterns for RAG pipelines and chatbots.' },
        { icon: '🔀', title: 'Smart Model Routing', desc: 'Route simple queries to cheap models (Groq Llama 8B at $0.05/M), complex reasoning to flagship models. Real routing logic with LiteLLM.' },
        { icon: '📦', title: 'Batch API Playbook', desc: 'Cut costs 50% with async batch processing. Use for classification, extraction, and content moderation at scale.' },
        { icon: '🔧', title: 'Open-Source Swap Guide', desc: 'Which tasks can be swapped from GPT-4o to DeepSeek V3 (90% cheaper) or Llama 3 (free self-hosted) with zero quality loss.' },
        { icon: '📊', title: 'Cost Monitoring Setup', desc: 'Prometheus + Grafana dashboard templates for tracking per-model token spend, error rates, and cost per request in production.' },
        { icon: '🏗️', title: 'Architecture Blueprints', desc: '5 complete system diagrams: chatbot, RAG pipeline, code review agent, content moderator, and translation service — all cost-optimized.' },
      ].map(item => (
        <div class="flex gap-5 bg-slate-50 rounded-xl p-5">
          <div class="text-3xl">{item.icon}</div>
          <div>
            <div class="font-bold text-slate-900 mb-1">{item.title}</div>
            <div class="text-slate-600 text-sm">{item.desc}</div>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-12 text-center">
      <a href="https://apexcraftweb.gumroad.com/l/aicost-handbook"
         target="_blank" rel="noopener sponsored"
         class="inline-flex items-center gap-2 bg-purple-600 hover:bg-purple-700 text-white font-bold py-5 px-10 rounded-2xl text-xl transition-all shadow-xl shadow-purple-200">
        Get Instant Access — $14.99 →
      </a>
    </div>
  </div>
</Layout>
