---
import models from '../../data/models.json';
import legacy from '../../data/legacy-models.json';
import Layout from '../../layouts/Layout.astro';
import Estimator from '../../components/Estimator.astro';
export function getStaticPaths(){return [...models.map(model=>({params:{id:model.id},props:{model,verified:true}})),...legacy.map(model=>({params:{id:model.id},props:{model,verified:false}}))];}
const {model,verified}=Astro.props;
---
<Layout title={`${model.name} — ${verified?'Reference API Cost Calculator':'Pricing Not Verified'} | AICost Matrix`} description={verified?`Source-linked text token fee estimate for ${model.name}. Direct Claude API, global routing; checked ${model.verifiedAt}.`:`The previous ${model.name} entry has not been verified for the current calculator. Check official provider documentation.`} canonical={`https://aicost.apexcraftweb.com/model/${model.id}`} noindex={!verified}>
<div class="wrap flow"><section style="padding-top:40px"><p class="eyebrow">{model.provider}</p><h1>{model.name}</h1>{verified?<p>Reference prices checked {model.verifiedAt}. <a href={model.sourceUrl}>Official price source ↗</a>. <a href="/methodology">Scope & formula</a>.</p>:<><p class="status">This older entry is not verified for the current version. Its old pricing and performance estimates are no longer presented as current facts.</p><p>Check model availability and rates with {model.provider}. This notice does not imply retirement.</p><a class="primary" href="/">Use checked reference models →</a></>}</section>{verified&&<Estimator initialModel={model.id}/>}</div></Layout>
